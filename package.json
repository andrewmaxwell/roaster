{
  "name": "roaster",
  "version": "1.0.0",
  "description": "Automated roast controller for a Kaleido M1 LITE",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node server/main.js",
    "sim": "node server/main.js --sim --speed 20",
    "stop": "node server/stop.js",
    "selftest": "node server/main.js --selftest --no-heat",
    "selftest:heat": "node server/main.js --selftest",
    "test": "node --test --test-force-exit test/*.test.js",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write ."
  },
  "dependencies": {
    "express": "^5.1.0",
    "serialport": "^13.0.0",
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.13.0",
    "prettier": "^3.9.10"
  }
}
